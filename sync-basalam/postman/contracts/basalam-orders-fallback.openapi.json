  "paths": {
    "/v3/vendor-parcels": {
      "get": {
        "tags": [
          "OpenApi - VendorOrder"
        ],
        "summary": "لیست سفارش های غرفه دار",
        "description": "<div dir='rtl'>\n        لیست سفارش های غرفه دار مرتب شده براساس مهلت ارسال را بر می گرداند.\n        <br/>\n        توجه کنید که برای مشاهده، به دسترسی `vendor.parcel.read` از سمت غرفه دار نیاز دارید.\n        <br />\n        برای مشاهده، تمام سفارش ها به دسترسی ادمین نیاز دارید.\n        </div>",
        "operationId": "vendor_list_parcels_v3_vendor_parcels_get",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Ids"
            }
          },
          {
            "name": "items.customer_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Items.Customer Ids"
            }
          },
          {
            "name": "items.vendor_ids",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "title": "Items.Vendor Ids"
            }
          },
          {
            "name": "items.product_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Items.Product Ids"
            }
          },
          {
            "name": "items.order_ids",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Items.Order Ids"
            }
          },
          {
            "name": "statuses",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "| Value | Name | translate | \n | :----: | ---- | :---- |\n | 3739 | NEW_ORDER | جدید |\n | 3237 | PREPARATION_IN_PROGRESS | در حال آماده سازی |\n | 3238 | POSTED | ارسال شده  |\n | 5017 | WRONG_TRACKING_CODE | اطلاعات ارسال نادرست |\n | 3572 | PRODUCT_IS_NOT_DELIVERED | نرسیده |\n | 3740 | PROBLEM_IS_REPORTED | ثبت مشکل شده |\n | 4633 | CUSTOMER_CANCEL_REQUEST_FROM_CUSTOMER | درخواست لغو مشتری |\n | 5075 | OVERDUE_AGREEMENT_REQUEST_FROM_VENDOR | درخواست توافق تاخیر |\n | 3195 | SATISFIED | رضایت  |\n | 3233 | DEFINITIVE_DISSATISFACTION | عودت وجه کامل |\n | 3067 | CANCEL | لغو \n | 6440 | VENDOR_CANCEL_REQUEST | درخواست لغو غرفه دار ",
              "title": "Statuses"
            },
            "description": "| Value | Name | translate | \n | :----: | ---- | :---- |\n | 3739 | NEW_ORDER | جدید |\n | 3237 | PREPARATION_IN_PROGRESS | در حال آماده سازی |\n | 3238 | POSTED | ارسال شده  |\n | 5017 | WRONG_TRACKING_CODE | اطلاعات ارسال نادرست |\n | 3572 | PRODUCT_IS_NOT_DELIVERED | نرسیده |\n | 3740 | PROBLEM_IS_REPORTED | ثبت مشکل شده |\n | 4633 | CUSTOMER_CANCEL_REQUEST_FROM_CUSTOMER | درخواست لغو مشتری |\n | 5075 | OVERDUE_AGREEMENT_REQUEST_FROM_VENDOR | درخواست توافق تاخیر |\n | 3195 | SATISFIED | رضایت  |\n | 3233 | DEFINITIVE_DISSATISFACTION | عودت وجه کامل |\n | 3067 | CANCEL | لغو \n | 6440 | VENDOR_CANCEL_REQUEST | درخواست لغو غرفه دار "
          },
